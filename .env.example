# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Deepgram API key for voice transcription
DEEPGRAM_API_KEY=

# Path to Obsidian vault directory
VAULT_PATH=./vault

# JSON array of Telegram user IDs allowed to use the bot (empty = allow all)
# The FIRST id also receives health alerts / daily reports.
ALLOWED_USER_IDS=[123456789]

# Timezone for systemd timers and reports (e.g. Asia/Tashkent, Europe/Moscow)
TZ=UTC

# Model for the persistent session. Empty = Claude Code default (Opus).
# Set to "sonnet" to reduce weekly-limit pressure for a 24/7 bot.
CLAUDE_MODEL=

# Scheduled jobs (the agent manages them itself via the cron skill).
# Defaults are sensible; set CRON_ENABLED=false to turn the ticker off.
CRON_ENABLED=true

# ── Advanced (defaults are fine — uncomment only if you know why) ──
# Runtime dir for session locks/logs and cron state (must be a LOCAL fs)
#RUNTIME_DIR=~/.dbrain
# tmux session name (empty = generated and persisted per install)
#BRAIN_SESSION_NAME=
# Allow EVERYONE to talk to the bot — security risk, leave false
#ALLOW_ALL_USERS=false
# Cron tuning: ticker interval / per-job timeout / failures before
# auto-disable / retry delay for a failed one-shot
#CRON_TICK_SECONDS=60
#CRON_JOB_TIMEOUT=600
#CRON_MAX_CONSECUTIVE_ERRORS=3
#CRON_RETRY_SECONDS=300
# R3 (Fable audit): one-time watchdog notification threshold (tokens) for
# the session's context size — no automatic /clear, notification only.
#CONTEXT_ALERT_TOKENS=400000
# tmux pane geometry for the Claude Code session. The defaults are what
# used to be hardcoded, so leaving both commented out changes nothing.
# Lower the WIDTH on an instance whose pane gets rendered in two columns
# (transcript left, a file diff right): text then follows the <<<E:id>>>
# marker on its line and replies stop being parsed (a real incident once).
# Do not go below 160 without also lowering tmux_parse._WRAP_MIN_LEN (140):
# soft-wrapped lines must stay longer than it or replies reach Telegram
# chopped mid-sentence. Height 50 is tied to _CHROME_LINES — see the
# comment on _PANE_HEIGHT in claude_session.py before changing it.
#DBRAIN_PANE_WIDTH=200
#DBRAIN_PANE_HEIGHT=50
# Engine per session. Both Claude Code and Codex CLI are supported.
# Keep chat and cron equal for a simple installation.
DBRAIN_CHAT_ENGINE=codex
DBRAIN_CRON_ENGINE=codex
# Empty means the CLI/account default model.
#DBRAIN_CODEX_MODEL=
# Durable inbox: how old an accepted-but-unanswered
# incoming message may be and still be replayed at startup. Default one
# hour. Anything older moves to RUNTIME_DIR/inbox/stale/ instead of being
# answered on boot — nothing is deleted. 0 disables the replay.
#DBRAIN_INBOX_REPLAY_MAX_AGE=3600
# Per-chat queue: one turn per chat at a time. A message
# that arrives while the main session is working is acknowledged at once
# ("принял, отвечу следом") and waits in RUNTIME_DIR/chat-queue/ until the
# session is free — the MAIN session answers it, not the duty stand-in.
# false restores the pre-queue behavior (brush-off / duty session).
#DBRAIN_CHAT_QUEUE=true
# How many messages ONE chat may have waiting before the sender is told
# plainly that this one will not be answered. 0 = no limit.
#DBRAIN_CHAT_QUEUE_MAX=10
# How long (seconds) a message may wait before the queue gives up on it and
# moves it to RUNTIME_DIR/chat-queue/stale/. 0 disables the age cap.
#DBRAIN_CHAT_QUEUE_MAX_AGE=7200

# Ночная уборка сервера (таймер dbrain-cleanup, 20:30 по местному времени):
# закрывает заброшенные окна терминала и чистит восстановимые кэши. Вопрос
# задаётся при установке; "off" гасит таймер при следующем обновлении.
DBRAIN_CLEANUP=on
